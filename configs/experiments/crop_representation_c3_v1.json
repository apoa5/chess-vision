{
  "schema_version": "crop_representation_c3_config_v1",
  "scope": "bounded_matched_cpu_training_development_only",
  "manifest": "data/classification/crops.json",
  "prepared_boards": "data/classification/prepared_boards.json",
  "images": "data/metadata/images.json",
  "positions": "data/metadata/positions.json",
  "reviews": "data/metadata/day9_board_reviews.json",
  "splits": ["train", "val"],
  "training_position_count": 12,
  "validation_position_count": 3,
  "historical_test_used": false,
  "D2_used_for_training_or_selection": false,
  "D3c_access_for_training_or_tuning": false,
  "final_holdout": false,
  "arms": {
    "b2": {"input_size": 224, "padding_squares": 1, "source": "existing_frozen_B2_context1_224_cache"},
    "taller": {"input_size": 224, "height_squares": 2.0, "raw_margin_squares": 0.35, "source": "native_source_RGB_with_frozen_projected_target_footprint"}
  },
  "seeds": [42, 43],
  "execution_order": [[42, "b2"], [42, "taller"], [43, "taller"], [43, "b2"]],
  "epochs": 6,
  "head_epochs": 2,
  "batch_size": 16,
  "cpu_threads": 4,
  "interop_threads": 1,
  "workers": 0,
  "initialization": "same_seed_ImageNet_MobileNetV3_Small_RGB; zero_mask_stem; new_13_class_head; no_chess_checkpoint_warm_start",
  "optimizer": "Adam",
  "learning_rate": 0.001,
  "fine_tune_learning_rate": 0.0001,
  "betas": [0.9, 0.999],
  "eps": 1e-8,
  "weight_decay": 0,
  "class_weights": "existing_train_only_sqrt_inverse_frequency",
  "augmentation": {"brightness": 0.1, "contrast": 0.1, "blur_probability": 0.15, "noise_probability": 0.2, "noise_std": 0.01},
  "geometric_augmentation": false,
  "checkpoint_selection": "highest_validation_occupied_accuracy; ties_fewer_empty_false_positives_then_lower_weighted_loss_then_earlier_epoch",
  "primary_metric": "validation_occupied_square_accuracy",
  "secondary_metrics": ["overall_accuracy", "empty_false_positives_and_rate", "per_class_recall_and_confusion", "king_rook_errors", "exact_boards", "per_position", "known_session_or_missing_status", "view_angle_and_orientation", "runtime_and_memory"],
  "performance_early_stopping": false,
  "resource_limits": {"max_peak_rss_bytes": 4294967296, "max_seconds_per_arm": 3600, "max_total_training_seconds": 14400},
  "failure_policy": "any_invalid_target_or_unmatched_budget_blocks_comparative_completion; never_silently_drop_samples_or_reduce_one_arm",
  "persist_crop_cache": false,
  "production_promotion": false
}
